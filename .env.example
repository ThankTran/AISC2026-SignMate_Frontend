VITE_API_BASE_URL=http://localhost:8080
# Offline demo progress only; production uses the API by default.
VITE_USE_MOCK=false
# Optional TURN relay for peers on different/restrictive networks. Use short-lived credentials.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=
VITE_DEMO=false
# auto: simulated calls in Vite dev, real calls in production builds.
# Use demo or real to explicitly override video calls without changing lesson APIs.
VITE_VIDEO_CALL_MODE=auto
# Leave empty to use the /handsign reverse proxy (Vite: localhost:8001).
VITE_HANDSIGN_API_URL=
# Leave empty to use /vsl (Vite proxies to localhost:8000).
# Production must route /vsl API and media requests to fast-api-trans-vsl.
VITE_VSL_API_URL=
